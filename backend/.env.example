# ExamPredict AI Environment Configuration

# Application
PROJECT_NAME="ExamPredict AI Backend"
API_V1_PREFIX="/api"

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./exam_predict.db"

# Storage
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"

# LLM Configuration (Default: Gemini)
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional Claude Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# CORS
CORS_ORIGINS=["*"]
