# ExamPredict AI Environment Configuration

# Application
PROJECT_NAME="ExamPredict AI Backend"
API_V1_PREFIX="/api"

# ==============================================================================
# Database Configuration
# ==============================================================================
# Default local SQLite:
# DATABASE_URL="sqlite+aiosqlite:///./exam_predict.db"

# Supabase PostgreSQL (Recommended - Connection Pooling on port 6543):
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Optional: Direct PostgreSQL Connection (port 5432):
# DATABASE_URL="postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ==============================================================================
# Supabase API, Auth & Storage (Optional / Extensible)
# ==============================================================================
# Set STORAGE_TYPE to "supabase" to sync file uploads to Supabase Storage:
STORAGE_TYPE="local" # "local" or "supabase"
UPLOAD_DIR="./uploads"

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="exam-uploads"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# ==============================================================================
# LLM Configuration (Default: Gemini)
# ==============================================================================
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional Claude Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# CORS
CORS_ORIGINS=["*"]
